  "name": "Color mapping",
  "func": "const { state, color } = msg.payload;\nif (!state || !color) return null;\nconst stateColors = context.get('stateColors') || {};\nstateColors[state] = color;\ncontext.set('stateColors', stateColors);\nmsg.payload = { stateColors };\nreturn msg;",
