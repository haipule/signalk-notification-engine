  "z": "tab-prototype",
  "name": "Color: red",
  "func": "const input = msg.payload;\nconst rule = context.get('rule') || { color: 'red', states: [], flash: false };\nif (input.type === 'state' && input.state && !rule.states.includes(input.state)) rule.states.push(input.state);\nif (input.type === 'flash') rule.flash = input.enabled === true;\ncontext.set('rule', rule);\nmsg.payload = { color: rule.color, states: rule.states, flash: rule.flash };\nreturn msg;",
  "outputs": 1,
  "x": 430,
  "y": 690,
  "wires": [["color-result"]]
